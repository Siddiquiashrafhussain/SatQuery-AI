# Database (Supabase)
SUPABASE_DB_URL=postgresql://postgres:[password]@[host]:5432/postgres
SUPABASE_PROJECT_URL=https://[project-id].supabase.co
SUPABASE_ANON_KEY=eyJ....
NEXT_PUBLIC_SUPABASE_URL=https://[project-id].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...
DATABASE_URL=${SUPABASE_DB_URL}
API_BASE_URL=http://localhost:${BACKEND_PORT}
STORAGE_PATH=/app/storage
MODEL_PATH=/app/models

# Frontend Config
FRONTEND_PORT=3000
VITE_API_URL=${API_BASE_URL}

# Future Architecture Placeholders
# REDIS_URL=redis://redis:6379/0
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password
STORAGE_BUCKET=satquery
STORAGE_ENDPOINT=http://minio:9000

# Auth
JWT_SECRET=super-secret-key-for-dev-only
JWT_ALGORITHM=HS256

# Mapillary API v4 — free street-level imagery for Ground View
# Register at https://www.mapillary.com/dashboard/developers
MAPILLARY_ACCESS_TOKEN=
NEXT_PUBLIC_MAPILLARY_TOKEN=
